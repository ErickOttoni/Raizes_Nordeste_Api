<mxfile host="app.diagrams.net"><diagram name="Arquitetura" id="arq1"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="a2" value="Arquitetura em camadas – Sistema de pedidos multicanal" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#000000;whiteSpace=wrap;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="700" height="30" as="geometry"/></mxCell><mxCell id="a3" value="&lt;b&gt;Cliente&lt;/b&gt;&lt;br&gt;App, Totem, Web ou Postman" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=12;align=center;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="400" height="50" as="geometry"/></mxCell><mxCell id="a4" value="&lt;b&gt;API (interface)&lt;/b&gt;&lt;br&gt;Rotas FastAPI e Swagger (/docs)&lt;br&gt;Autenticação (401) e perfil (403)&lt;br&gt;Schemas Pydantic e erros no padrão do projeto" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="400" height="120" as="geometry"/></mxCell><mxCell id="a5" value="&lt;b&gt;Application (casos de uso)&lt;/b&gt;&lt;br&gt;CriarPedido, PagarPedido, ConsultarCardapio...&lt;br&gt;Orquestra o fluxo, a transação e a auditoria&lt;br&gt;Define as portas: repositórios, PagamentoGateway, TokenService e Relógio" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="400" height="140" as="geometry"/></mxCell><mxCell id="a6" value="&lt;b&gt;Domain (regras de negócio)&lt;/b&gt;&lt;br&gt;Pedido, ItemPedido, ItemCardapio, Estoque...&lt;br&gt;Status, total, reserva e pontos&lt;br&gt;Sem framework e sem banco" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="550" width="400" height="120" as="geometry"/></mxCell><mxCell id="a7" value="&lt;b&gt;main.py e container.py&lt;/b&gt;&lt;br&gt;Montam as camadas e ligam cada porta à sua implementação&lt;br&gt;São os únicos que conhecem as quatro camadas" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="620" y="150" width="400" height="120" as="geometry"/></mxCell><mxCell id="a8" value="&lt;b&gt;Infrastructure (detalhes técnicos)&lt;/b&gt;&lt;br&gt;Repositórios SQLAlchemy e migrations Alembic&lt;br&gt;Adaptador do gateway de pagamento (simularResultado)&lt;br&gt;JWT, bcrypt, configuração e relógio real" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="340" width="400" height="140" as="geometry"/></mxCell><mxCell id="a9" value="MySQL 8.0" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="640" y="560" width="160" height="100" as="geometry"/></mxCell><mxCell id="a10" value="&lt;b&gt;Gateway de pagamento (mock)&lt;/b&gt;&lt;br&gt;Resultado: APROVADO, RECUSADO ou ERRO_GATEWAY" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="840" y="560" width="180" height="100" as="geometry"/></mxCell><mxCell id="a11" value="HTTP" style="html=1;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="a3" target="a4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a12" value="chama" style="html=1;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="a4" target="a5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a13" value="usa" style="html=1;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="a5" target="a6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a14" value="implementa as portas" style="html=1;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endSize=10;endArrow=block;endFill=0;dashed=1;" edge="1" parent="1" source="a8" target="a5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a15" value="converte de/para entidades" style="html=1;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="a8" target="a6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a16" value="SQL" style="html=1;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="a8" target="a9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a17" value="chamada" style="html=1;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="a8" target="a10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a18" value="Seta cheia: depende de ou usa. Seta tracejada com ponta vazia: implementa a interface. Caixas tracejadas: fora das camadas (montagem e sistema externo simulado)." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#000000;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="710" width="700" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>